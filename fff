


IF OBJECT_ID('dbo.TempUsers', 'U') IS NOT NULL
    DROP TABLE dbo.TempUsers;

CREATE TABLE dbo.TempUsers (
    id INT NULL,                 -- Разрешаем NULL
    username NVARCHAR(50) NULL,  -- Разрешаем NULL
    email NVARCHAR(100) NULL,    -- Разрешаем NULL
    age INT NULL                 -- Разрешаем NULL
);


