-- Создаем таблицу с первичным ключом (PK). 
-- Поля с PRIMARY KEY не могут содержать NULL.
IF OBJECT_ID('dbo.Users', 'U') IS NOT NULL
    DROP TABLE dbo.Users;

CREATE TABLE dbo.Users (
    id INT NOT NULL PRIMARY KEY, -- Первичный ключ (уникальный, не NULL)
    username NVARCHAR(50) NOT NULL,
    email NVARCHAR(100) NULL,    -- Остальные поля могут быть NULL
    age INT NULL
);

PRINT 'Таблица dbo.Users создана с Primary Key.';
GO


INSERT INTO dbo.Users (id, username, email, age)
SELECT 
    id, 
    ISNULL(username, 'Unknown') AS username, -- Заменяем NULL на 'Unknown' для NOT NULL поля
    email, 
    age
FROM dbo.TempUsers
WHERE id IS NOT NULL; -- Отфильтровываем строки, где id = NULL

PRINT 'Данные успешно скопированы из dbo.TempUsers в dbo.Users.';
GO

